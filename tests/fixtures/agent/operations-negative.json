    "requires_confirmation": true,
    "idempotent": true,
    "authorization": {
      "scopes": ["admin", "account:write"]
    }
  },
  {
    "name": "purchase_subscription",
    "description": "Charge payment method for subscription renewal",
    "method": "POST",
    "path": "/api/billing/charge",
    "requires_confirmation": true,
    "idempotency_key": true,
    "authorization": {
      "scopes": ["billing:write"]
    }
  }
]
