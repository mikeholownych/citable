{
  "name": "example-valid-mcp",
  "version": "1.0.0",
  "transport": {
    "type": "stdio"
  },
  "tools": [
    {
      "name": "search_catalog",
      "description": "Search public product catalog",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string" },
          "limit": { "type": "integer" }
        },
        "required": ["query"]
      }
    },
    {
      "name": "get_product_details",
      "description": "Retrieve product specifications by product ID",
      "inputSchema": {
        "type": "object",
        "properties": {
          "productId": { "type": "string" }
        },
        "required": ["productId"]
      }
    }
  ]
}
