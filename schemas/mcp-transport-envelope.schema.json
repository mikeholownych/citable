{
  "$id": "citable://schemas/mcp-transport-envelope.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Model Context Protocol evidence transport envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "transport",
    "server",
    "tool",
    "request",
    "response",
    "provenance",
    "authority",
    "status",
    "collected_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "transport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocol_version",
        "timeout_ms",
        "max_bytes"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stdio",
            "http"
          ]
        },
        "protocol_version": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$|^[0-9]+\\.[0-9]+.*$"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "max_bytes": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 10485760
        },
        "retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server_id",
        "transport_target",
        "allowlisted"
      ],
      "properties": {
        "server_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "package_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "pinned_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "transport_target": {
          "type": "string",
          "minLength": 1
        },
        "allowlisted": {
          "type": "boolean"
        },
        "capabilities": {
          "type": "object"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "read_only",
        "input_schema_hash"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_.-]+$"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "read_only": {
          "type": "boolean"
        },
        "input_schema_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_schema": {
          "type": "object"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arguments_hash",
        "arguments"
      ],
      "properties": {
        "arguments_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "arguments": {
          "type": "object"
        },
        "authorization_mode": {
          "type": "string",
          "enum": [
            "none",
            "environment",
            "bearer_token",
            "header"
          ]
        },
        "scopes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_sha256",
        "content_bytes",
        "is_error",
        "retention_reason"
      ],
      "properties": {
        "raw_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "is_error": {
          "type": "boolean"
        },
        "retention_reason": {
          "type": "string",
          "enum": [
            "raw_preserved",
            "hash_locked_only",
            "redacted_sensitive"
          ]
        },
        "content": {
          "type": "array"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_version",
        "normalization_version",
        "sanitized_redactions"
      ],
      "properties": {
        "adapter_version": {
          "type": "string"
        },
        "normalization_version": {
          "type": "string"
        },
        "sanitized_redactions": {
          "type": "integer",
          "minimum": 0
        },
        "duration_ms": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "authority": {
      "$ref": "citable://schemas/evidence-authority.schema.json"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "incomplete",
        "failed",
        "unsupported",
        "unauthorized"
      ]
    },
    "collected_at": {
      "type": "string",
      "format": "date-time"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
