{
  "$id": "citable://schemas/domain-module.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Domain module contract",
  "description": "First-class domain module interface registering conditions, observation kinds, collectors, and report projections.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "namespace",
    "title",
    "description",
    "conditions",
    "observation_kinds",
    "collectors",
    "report_projections"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "module_id": {
      "$ref": "citable://schemas/common.defs.json#/definitions/id"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "observation_kinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collectors": {
      "type": "object"
    },
    "report_projections": {
      "type": "object"
    },
    "gating": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "default_enabled": {
          "type": "boolean"
        },
        "requires_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "disallowed_profiles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
