{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "citable://schemas/webeffect-dependency-graph.schema.json",
  "title": "WebEffectDependencyGraph",
  "description": "Third-party dependency inventory and impact graph modeling performance, blocking, failure, and privacy effects (B-075).",
  "type": "object",
  "required": [
    "schema_version",
    "graph_id",
    "site_url",
    "dependencies",
    "total_dependencies",
    "blocking_count",
    "critical_failure_dependencies",
    "generated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "graph_id": {
      "type": "string",
      "pattern": "^dep_grp_[a-f0-9]{8,32}$"
    },
    "site_url": {
      "type": "string"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "dependency_id",
          "name",
          "host_domain",
          "purpose",
          "blocking_state",
          "performance_cost",
          "failure_effect",
          "privacy_effect"
        ],
        "additionalProperties": false,
        "properties": {
          "dependency_id": { "type": "string" },
          "name": { "type": "string" },
          "host_domain": { "type": "string" },
          "purpose": {
            "type": "string",
            "enum": [
              "analytics",
              "advertising",
              "customer_support",
              "payments",
              "identity",
              "fonts",
              "cdn",
              "tag_manager",
              "security",
              "unknown"
            ]
          },
          "blocking_state": {
            "type": "string",
            "enum": [
              "render_blocking",
              "parser_blocking",
              "async",
              "deferred",
              "preloaded"
            ]
          },
          "performance_cost": {
            "type": "object",
            "required": ["transfer_size_bytes", "estimated_execution_time_ms"],
            "additionalProperties": false,
            "properties": {
              "transfer_size_bytes": { "type": "integer", "minimum": 0 },
              "estimated_execution_time_ms": { "type": "integer", "minimum": 0 }
            }
          },
          "failure_effect": {
            "type": "string",
            "enum": [
              "benign_fail_open",
              "degraded_ux",
              "critical_blocking",
              "payment_outage"
            ]
          },
          "privacy_effect": {
            "type": "object",
            "required": ["collects_pii", "sets_cookies", "shares_data_broker"],
            "additionalProperties": false,
            "properties": {
              "collects_pii": { "type": "boolean" },
              "sets_cookies": { "type": "boolean" },
              "shares_data_broker": { "type": "boolean" }
            }
          }
        }
      }
    },
    "total_dependencies": {
      "type": "integer",
      "minimum": 0
    },
    "blocking_count": {
      "type": "integer",
      "minimum": 0
    },
    "critical_failure_dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
