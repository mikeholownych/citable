{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "citable://schemas/agent-journey.schema.json",
  "title": "AgentJourney",
  "description": "Bounded task-oriented agent journey outcome with grounded evidence citations (B-065).",
  "type": "object",
  "required": [
    "schema_version",
    "journey_id",
    "journey_type",
    "goal",
    "outcome",
    "steps",
    "evidence_summary",
    "executed_at"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [1]
    },
    "journey_id": {
      "type": "string",
      "pattern": "^jrn_[a-f0-9]{12,64}$"
    },
    "journey_type": {
      "type": "string",
      "enum": ["content", "saas", "ecommerce", "support", "custom"]
    },
    "goal": {
      "type": "string"
    },
    "outcome": {
      "type": "string",
      "enum": ["SUCCESS", "PARTIAL", "FAILED", "INDETERMINATE", "BLOCKED"]
    },
    "outcome_reason": {
      "type": ["string", "null"]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "step_index",
          "description",
          "status",
          "extracted_answers"
        ],
        "additionalProperties": false,
        "properties": {
          "step_index": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": ["SUCCESS", "PARTIAL", "FAILED", "INDETERMINATE", "BLOCKED"]
          },
          "extracted_answers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "claim_or_property",
                "extracted_value",
                "source_url",
                "source_element",
                "source_text",
                "evidence_type"
              ],
              "additionalProperties": false,
              "properties": {
                "claim_or_property": { "type": "string" },
                "extracted_value": {},
                "source_url": { "type": "string" },
                "source_element": { "type": "string" },
                "source_text": { "type": "string" },
                "evidence_type": {
                  "type": "string",
                  "enum": ["DIRECT_EVIDENCE", "DERIVED_INTERPRETATION", "MODEL_INFERENCE"],
                  "description": "Strictly distinguishes raw direct observations from derived heuristics and probabilistic model inferences."
                },
                "confidence": {
                  "type": ["string", "null"],
                  "enum": ["confirmed", "high", "medium", "low", "unverified", null]
                }
              }
            }
          },
          "error_or_refusal": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "evidence_summary": {
      "type": "object",
      "required": [
        "direct_evidence_count",
        "derived_interpretation_count",
        "model_inference_count"
      ],
      "additionalProperties": false,
      "properties": {
        "direct_evidence_count": { "type": "integer", "minimum": 0 },
        "derived_interpretation_count": { "type": "integer", "minimum": 0 },
        "model_inference_count": { "type": "integer", "minimum": 0 }
      }
    },
    "executed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
