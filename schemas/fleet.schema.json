{
  "$id": "citable://schemas/fleet.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fleet Properties registry",
  "allOf": [
    {
      "$ref": "citable://schemas/common.defs.json#/definitions/registryFile"
    }
  ],
  "properties": {
    "kind": {
      "const": "fleet"
    },
    "entries": {
      "items": {
        "$ref": "#/definitions/fleetProperty"
      }
    }
  },
  "definitions": {
    "fleetProperty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "property_id",
        "name",
        "primary_domain",
        "environment",
        "status"
      ],
      "properties": {
        "property_id": {
          "$ref": "citable://schemas/common.defs.json#/definitions/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "primary_domain": {
          "type": "string",
          "minLength": 3
        },
        "domains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "string",
          "enum": [
            "production",
            "staging",
            "development",
            "preview"
          ]
        },
        "base_url": {
          "type": "string"
        },
        "built_output_dir": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audit_schedule": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "archived"
          ]
        },
        "updated": {
          "$ref": "citable://schemas/common.defs.json#/definitions/isoDate"
        }
      }
    }
  }
}
