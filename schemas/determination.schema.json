{
  "$id": "citable://schemas/determination.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Condition determination",
  "description": "Per-condition per-subject evaluation outcome record.",
  "type": "object",
  "required": [
    "determination_id",
    "condition_id",
    "detector_id",
    "run_id",
    "timestamp",
    "subject",
    "status"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "determination_id": {
      "$ref": "citable://schemas/common.defs.json#/definitions/id"
    },
    "condition_id": {
      "$ref": "citable://schemas/common.defs.json#/definitions/id"
    },
    "condition_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "detector_id": {
      "$ref": "citable://schemas/common.defs.json#/definitions/id"
    },
    "detector_name": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    },
    "subject": {
      "type": "object",
      "required": [
        "type",
        "identifier"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "identifier": {
          "type": "string"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_file": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "WARNING",
        "INDETERMINATE",
        "NOT_APPLICABLE",
        "NOT_TESTED",
        "ERROR"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "finding_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "discipline": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": [
        "string",
        "null"
      ]
    },
    "collector_failure": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "DNS_FAILED",
        "TIMEOUT",
        "BLOCKED",
        "CAPTCHA",
        "RATE_LIMITED",
        "PARSER_FAILED",
        null
      ]
    },
    "site_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "applicable": {
      "type": "boolean"
    },
    "provenance": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
